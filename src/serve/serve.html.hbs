<h1 class="prompt">DCM Diff Report</h1>

<!-- Metadata -->
<div class="meta">
  <table>
    <tr><td class="label">ORIGINAL</td><td class="value">{{metadata.original_file}}</td></tr>
    <tr><td class="label">MODIFIED</td><td class="value">{{metadata.modified_file}}</td></tr>
    <tr><td class="label">TIMESTAMP</td><td class="value">{{metadata.timestamp}}</td></tr>
    <tr><td class="label">APPROX_MODE</td><td class="value">{{approx}}</td></tr>
  </table>
</div>

<!-- Statistics -->
<div class="prompt">STATUS</div>
<div class="stats">
  <div class="stat-card stat-new"><div class="num">{{summary.new_count}}</div><div class="label">New</div></div>
  <div class="stat-card stat-del"><div class="num">{{summary.deleted_count}}</div><div class="label">Deleted</div></div>
  <div class="stat-card stat-chg"><div class="num">{{summary.changed_count}}</div><div class="label">Changed</div></div>
  <div class="stat-card stat-tot"><div class="num">{{summary.total}}</div><div class="label">Total</div></div>
</div>

<!-- New Variables -->
<div class="section sec-new">
  <div class="section-header">
    <h2 class="prompt">+ {{summary.new_count}} New Variables</h2>
    <a class="export-btn" href="/export/new" download>&darr; Export CSV</a>
  </div>
  {{#if new_items}}
  <table class="diff-table">
    <tr><th class="col-num">#</th><th>Variable Name</th><th>Type</th><th>Description</th></tr>
    {{#each new_items}}
    <tr><td class="col-num">{{index}}</td><td class="col-name"><span class="changed-name" data-name="{{name}}">{{name}}</span></td><td class="col-type">{{type}}</td><td class="col-desc">{{description}}</td></tr>
    {{/each}}
  </table>
  {{else}}
  <div class="empty-msg">// no new variables</div>
  {{/if}}
</div>

<!-- Changed Variables -->
<div class="section sec-chg">
  <div class="section-header">
    <h2 class="prompt">~ {{summary.changed_count}} Changed Variables</h2>
    <a class="export-btn" href="/export/changed" download>&darr; Export CSV</a>
  </div>
  {{#if changed_items}}
  <table class="diff-table">
    <tr><th class="col-num">#</th><th>Variable Name</th><th>Type</th><th>Change Summary</th></tr>
    {{#each changed_items}}
    <tr><td class="col-num">{{index}}</td><td class="col-name"><span class="changed-name" data-name="{{name}}">{{name}}</span></td><td class="col-type">{{type}}</td><td class="col-desc">{{change_summary}}</td></tr>
    {{/each}}
  </table>
  {{else}}
  <div class="empty-msg">// no changed variables</div>
  {{/if}}
</div>

<!-- Deleted Variables -->
<div class="section sec-del">
  <div class="section-header">
    <h2 class="prompt">&minus; {{summary.deleted_count}} Deleted Variables</h2>
    <a class="export-btn" href="/export/deleted" download>&darr; Export CSV</a>
  </div>
  {{#if deleted_items}}
  <table class="diff-table">
    <tr><th class="col-num">#</th><th>Variable Name</th><th>Type</th><th>Description</th></tr>
    {{#each deleted_items}}
    <tr><td class="col-num">{{index}}</td><td class="col-name"><span class="changed-name" data-name="{{name}}">{{name}}</span></td><td class="col-type">{{type}}</td><td class="col-desc">{{description}}</td></tr>
    {{/each}}
  </table>
  {{else}}
  <div class="empty-msg">// no deleted variables</div>
  {{/if}}
</div>

<div class="footer">generated by dcm_utils // {{metadata.timestamp}}</div>

<!-- Diff Detail Modal -->
{{#if has_changes}}
<div id="diff-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <span class="modal-title"></span>
      <button class="modal-close" title="Close (Esc)">[x]</button>
    </div>
    <div class="modal-body"></div>
  </div>
</div>

<script id="change-details" type="application/json">{{{change_details_json}}}</script>
<script>
(function() {
  var modal = document.getElementById('diff-modal');
  var modalTitle = modal.querySelector('.modal-title');
  var modalBody = modal.querySelector('.modal-body');
  var detailEl = document.getElementById('change-details');
  var details = {};
  var approx = {{approx}};

  if (detailEl) {
    try { details = JSON.parse(detailEl.textContent); } catch(e) {}
  }

  // Click handlers on changed variable names
  var names = document.querySelectorAll('.changed-name');
  for (var i = 0; i < names.length; i++) {
    names[i].addEventListener('click', function() {
      showModal(this.getAttribute('data-name'));
    });
  }

  // Close: button
  modal.querySelector('.modal-close').addEventListener('click', closeModal);

  // Close: click outside content
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  // Close: ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
  });

  function showModal(name) {
    var d = details[name];
    if (!d) return;
    modalTitle.textContent = name + ' — ' + d.block_type;
    modalBody.innerHTML = renderDetail(d);
    modal.classList.add('show');
    modal.scrollTop = 0;
  }

  function closeModal() {
    modal.classList.remove('show');
  }

  function isStr(v) { return typeof v === 'string' || v instanceof String; }

  // Format a value for display
  function fmt(n) {
    if (isStr(n)) return n;
    if (typeof n !== 'number') return String(n);
    return parseFloat(n.toFixed(6)).toString();
  }

  // Escape HTML entities
  function esc(s) {
    if (Array.isArray(s)) s = s.join(', ');
    if (typeof s !== 'string') s = String(s);
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Compare two values: return 'same' or 'diff'
  function cmp(a, b) {
    if (isStr(a) && isStr(b)) return a === b ? 'same' : 'diff';
    if (approx && typeof a === 'number' && typeof b === 'number') {
      var denom = Math.max(Math.abs(a), Math.abs(b), 1e-12);
      return Math.abs(a - b) / denom < 1e-8 ? 'same' : 'diff';
    }
    return a === b ? 'same' : 'diff';
  }

  function renderDetail(d) {
    d.approx = approx;
    switch (d.kind) {
      case 'scalar': return renderScalar(d);
      case 'multi':  return renderMulti(d);
      case 'single': return renderSingle(d);
      case 'single_array': return renderSingleArray(d);
      case 'multi_with_axis': return renderSingleWithAxis(d);
      case 'curve':  return renderCurve(d);
      case 'map':    return renderMap(d);
      case 'mixed':  return '<p style="padding:20px;color:#3a6a3a;">// value type mismatch — cannot compare</p>';
      default:       return '<p style="padding:20px;color:#3a6a3a;">// no detail data available</p>';
    }
  }

  // Compute element-by-element diff of two arrays
  function diffArrays(oldArr, newArr) {
    var result = [];
    var len = Math.max(oldArr.length, newArr.length);
    for (var i = 0; i < len; i++) {
      var o = oldArr[i], n = newArr[i];
      if (o === undefined) result.push({idx: i, old: undefined, new: n, cls: 'diff', missing: 'old'});
      else if (n === undefined) result.push({idx: i, old: o, new: undefined, cls: 'diff', missing: 'new'});
      else result.push({idx: i, old: o, new: n, cls: cmp(o, n)});
    }
    return result;
  }

  // Render a compact axis comparison table; returns empty string if unchanged
  function renderAxisTable(label, oldAxis, newAxis) {
    var rows = diffArrays(oldAxis, newAxis);
    var unchanged = rows.every(function(r) { return r.cls === 'same'; });
    if (unchanged) return '';
    var h = '<div class="cmp-section-label">' + label + ' (changed)</div>';
    h += '<table class="cmp-table" style="margin-bottom:12px;"><tr><th>#</th><th>Old</th><th>New</th></tr>';
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r.missing === 'old') {
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="missing">&mdash;</td><td class="diff">' + fmt(r.new) + '</td></tr>';
      } else if (r.missing === 'new') {
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="diff">' + fmt(r.old) + '</td><td class="missing">&mdash;</td></tr>';
      } else {
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="' + r.cls + '">' + fmt(r.old) + '</td><td class="' + r.cls + '">' + fmt(r.new) + '</td></tr>';
      }
    }
    h += '</table>';
    return h;
  }

  function renderScalar(d) {
    var o = d.old_values[0], n = d.new_values[0];
    var cls = cmp(o, n);
    return '<table class="cmp-table"><tr><th></th><th>Old</th><th>New</th></tr>' +
      '<tr><td class="cmp-label">Val</td>' +
      '<td class="' + cls + '">' + fmt(o) + '</td>' +
      '<td class="' + cls + '">' + fmt(n) + '</td></tr></table>';
  }

  function renderMulti(d) {
    var h = '<table class="cmp-table"><tr><th>#</th><th>Old</th><th>New</th></tr>';
    var len = Math.max(d.old_values.length, d.new_values.length);
    for (var i = 0; i < len; i++) {
      var o = d.old_values[i], n = d.new_values[i];
      if (o === undefined) {
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="missing">&mdash;</td><td class="diff">' + fmt(n) + '</td></tr>';
      } else if (n === undefined) {
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="diff">' + fmt(o) + '</td><td class="missing">&mdash;</td></tr>';
      } else {
        var cls = cmp(o, n);
        h += '<tr><td class="cmp-label">' + (i+1) + '</td><td class="' + cls + '">' + fmt(o) + '</td><td class="' + cls + '">' + fmt(n) + '</td></tr>';
      }
    }
    h += '</table>';
    return h;
  }

  // Render a single scalar value
  function renderSingle(d) {
    return '<table class="cmp-table"><tr><th></th><th>Value</th></tr>' +
      '<tr><td class="cmp-label">Val</td><td class="same">' + fmt(d.values[0]) + '</td></tr></table>';
  }

  // Render a single array of values — axis and data in one table
  function renderSingleArray(d) {
    var len = Math.max(d.values ? d.values.length : 0, d.axis ? d.axis.length : 0);
    var h = '<div class="cmp-section-label">Data</div>';
    h += '<table class="cmp-table"><tr><th>#</th>';
    if (d.axis) h += '<th>Axis' + (d.axis_var_name ? ' (' + esc(d.axis_var_name) + ')' : '') + '</th>';
    h += '<th>Value</th></tr>';
    for (var i = 0; i < len; i++) {
      h += '<tr><td class="cmp-label">' + (i+1) + '</td>';
      if (d.axis) h += '<td class="axis-label">' + (d.axis[i] !== undefined ? fmt(d.axis[i]) : '&mdash;') + '</td>';
      h += '<td class="same">' + (d.values[i] !== undefined ? fmt(d.values[i]) : '&mdash;') + '</td></tr>';
    }
    h += '</table>';
    return h;
  }

  // Curve comparison — axis, old, and new in one table
  function renderCurve(d) {
    var h = '';
    var axis = d.old_axis || d.new_axis || [];
    var axisChanged = false;
    if (d.old_axis && d.new_axis) {
      var axisDiff = diffArrays(d.old_axis, d.new_axis);
      axisChanged = !axisDiff.every(function(r) { return r.cls === 'same'; });
      if (axisChanged) h += renderAxisTable('Axis Points', d.old_axis, d.new_axis);
    }
    var len = Math.max(d.old_values.length, d.new_values.length);
    h += '<div class="cmp-section-label">Curve Data</div>';
    h += '<table class="cmp-table"><tr><th>#</th>';
    if (axis.length > 0) h += '<th>Axis</th>';
    h += '<th>Old</th><th>New</th></tr>';
    for (var i = 0; i < len; i++) {
      var o = d.old_values[i], n = d.new_values[i];
      h += '<tr><td class="cmp-label">' + (i+1) + '</td>';
      if (axis.length > 0) h += '<td class="axis-label">' + (axis[i] !== undefined ? fmt(axis[i]) : '&mdash;') + '</td>';
      if (o === undefined) {
        h += '<td class="missing">&mdash;</td><td class="diff">' + fmt(n) + '</td>';
      } else if (n === undefined) {
        h += '<td class="diff">' + fmt(o) + '</td><td class="missing">&mdash;</td>';
      } else {
        var cls = cmp(o, n);
        h += '<td class="' + cls + '">' + fmt(o) + '</td><td class="' + cls + '">' + fmt(n) + '</td>';
      }
      h += '</tr>';
    }
    h += '</table>';
    return h;
  }

  function renderMap(d) {
    var h = '';

    // Show axis comparisons when axes differ
    if (d.old_x_axis && d.new_x_axis) {
      h += renderAxisTable('X-Axis (' + esc(d.x_axis_name) + ')', d.old_x_axis, d.new_x_axis);
    }
    if (d.old_y_axis && d.new_y_axis) {
      h += renderAxisTable('Y-Axis (' + esc(d.y_axis_name) + ')', d.old_y_axis, d.new_y_axis);
    }

    h += '<div class="cmp-section-label">Map Data (' + d.dim_x + ' &times; ' + d.dim_y + ')</div>';
    h += '<div class="map-grid-wrapper"><table class="cmp-table map-grid">';
    // Header: old X axis values
    h += '<tr><th></th>';
    for (var x = 0; x < d.dim_x; x++) {
      h += '<th class="axis-label">' + (d.old_x_axis && d.old_x_axis[x] !== undefined ? fmt(d.old_x_axis[x]) : '&mdash;') + '</th>';
    }
    h += '</tr>';
    // Data rows (row-major: old dims define grid shape)
    for (var y = 0; y < d.dim_y; y++) {
      var yLabel = d.old_y_axis && d.old_y_axis[y] !== undefined ? fmt(d.old_y_axis[y]) : '&mdash;';
      h += '<tr><th class="axis-label">' + yLabel + '</th>';
      for (var x = 0; x < d.dim_x; x++) {
        var idx = y * d.dim_x + x;
        var o = d.old_values[idx], n = d.new_values[idx];
        var cls = cmp(o, n);
        h += '<td class="map-cell ' + cls + '"><span class="old-val">' + fmt(o) + '</span><span class="new-val">' + fmt(n) + '</span></td>';
      }
      h += '</tr>';
    }
    h += '</table></div>';

    // Legend
    var sameCount = 0, diffCount = 0;
    for (var i = 0; i < d.old_values.length; i++) {
      if (cmp(d.old_values[i], d.new_values[i]) === 'same') sameCount++; else diffCount++;
    }
    h += '<div class="cmp-summary" style="margin-top:12px;">' +
      '<span style="color:#ffb000;">* ' + diffCount + ' changed</span> &nbsp; ' +
      '<span style="color:#3a5a3a;">* ' + sameCount + ' unchanged</span></div>';
    return h;
  }

})();
</script>
{{/if}}

</body>
</html>
