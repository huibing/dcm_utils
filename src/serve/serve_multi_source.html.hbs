<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Multi-Source Calibration Diff</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #1e1e2e; color: #cdd6f4; margin: 0; padding: 2rem;
    line-height: 1.6;
  }
  h1 { font-size: 1.8rem; border-bottom: 2px solid #45475a; padding-bottom: .5rem; }
  h2 { font-size: 1.3rem; margin-top: 2rem; }
  .meta { background: #181825; padding: 1rem 1.5rem; border-radius: 8px; margin: 1rem 0; }
  .meta table { width: 100%; border-collapse: collapse; }
  .meta td { padding: 4px 0; }
  .meta .label { color: #a6adc8; width: 120px; font-weight: 600; }
  .meta .value { color: #cdd6f4; }
  .source-label { font-weight: 700; }
  .source-label.base { color: #89b4fa; }
  .source-label.other { color: #a6e3a1; }
  .stats { display: flex; gap: 1rem; margin: 1rem 0; flex-wrap: wrap; }
  .stat-card {
    background: #181825; padding: 1rem 2rem; border-radius: 8px; text-align: center;
    flex: 0 0 auto; min-width: 140px;
  }
  .stat-card .num { font-size: 2rem; font-weight: 700; }
  .stat-card .label { font-size: .85rem; color: #a6adc8; }
  .stat-card.stat-total .num { color: #89b4fa; }
  .stat-card.stat-diff .num { color: #f9e2af; }
  table.diff-table {
    width: 100%; border-collapse: collapse; margin-top: .5rem;
    background: #181825; border-radius: 8px; overflow: hidden;
  }
  .diff-table th {
    background: #313244; padding: 10px 12px; text-align: left;
    font-weight: 600; font-size: .85rem; color: #a6adc8;
    white-space: nowrap; position: sticky; top: 0;
  }
  .diff-table td { padding: 8px 12px; border-top: 1px solid #313244; font-size: .9rem; vertical-align: top; }
  .diff-table tr:hover { background: #1e1e2e; }
  .col-name { min-width: 180px; font-family: 'SFMono-Regular', 'Consolas', monospace; }
  .col-type { width: 100px; color: #a6adc8; }
  .val-present { color: #a6e3a1; }
  .val-missing { color: #f38ba8; font-style: italic; }
  .val-same { color: #6c7086; }
  .val-diff { color: #f9e2af; }
  .truncate {
    max-width: 200px; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap; display: inline-block; vertical-align: bottom;
  }
  .footer { margin-top: 3rem; text-align: center; color: #6c7086; font-size: .8rem; }
</style>
</head>
<body>

<h1>Multi-Source Calibration Diff</h1>

<!-- Metadata -->
<div class="meta">
  <table>
    {{#each metadata.sources}}
    <tr>
      <td class="label">{{#if @first}}BASE SOURCE{{else}}SOURCE {{@index}}{{/if}}</td>
      <td class="value"><span class="source-label {{#if @first}}base{{else}}other{{/if}}">{{this}}</span></td>
    </tr>
    {{/each}}
  </table>
</div>

<!-- Statistics -->
<div class="stats">
  <div class="stat-card stat-total">
    <div class="num">{{total_variables}}</div>
    <div class="label">Base Variables</div>
  </div>
  <div class="stat-card stat-diff">
    <div class="num">{{variables_with_diffs}}</div>
    <div class="label">With Differences</div>
  </div>
</div>

<!-- Differences Table -->
{{#if differences}}
<h2>Variables with Differences</h2>
<div style="overflow-x: auto;">
<table class="diff-table">
  <thead>
    <tr>
      <th class="col-name">Variable</th>
      <th class="col-type">Type</th>
      {{#each metadata.sources}}
      <th>{{#if @first}}Base{{else}}Source {{@index}}{{/if}}</th>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each differences}}
    <tr>
      <td class="col-name">{{name}}</td>
      <td class="col-type">{{block_type}}</td>
      {{#each source_values}}
      <td>
        {{#if present}}
          {{#if value}}
            <span class="truncate val-present">{{format_value value}}</span>
          {{else}}
            <span class="val-missing">(no value)</span>
          {{/if}}
        {{else}}
          <span class="val-missing">(missing)</span>
        {{/if}}
      </td>
      {{/each}}
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
{{else}}
<p style="color: #a6e3a1;">All variables match across all sources. No differences found.</p>
{{/if}}

<div class="footer">
  Generated by DCM Utils
</div>

</body>
</html>