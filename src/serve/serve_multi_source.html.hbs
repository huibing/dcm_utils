<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Multi-Source Calibration Diff</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #1e1e2e; color: #cdd6f4; margin: 0; padding: 2rem;
    line-height: 1.6;
  }
  h1 { font-size: 1.8rem; border-bottom: 2px solid #45475a; padding-bottom: .5rem; }
  h2 { font-size: 1.3rem; margin-top: 2rem; }
  .meta { background: #181825; padding: 1rem 1.5rem; border-radius: 8px; margin: 1rem 0; }
  .meta table { width: 100%; border-collapse: collapse; }
  .meta td { padding: 4px 0; }
  .meta .label { color: #a6adc8; width: 140px; font-weight: 600; }
  .meta .value { color: #cdd6f4; }
  .source-label { font-weight: 700; }
  .source-label.base { color: #89b4fa; }
  .source-label.other { color: #a6e3a1; }
  .stats { display: flex; gap: 1rem; margin: 1rem 0; flex-wrap: wrap; }
  .stat-card {
    background: #181825; padding: 1rem 2rem; border-radius: 8px; text-align: center;
    flex: 0 0 auto; min-width: 140px;
  }
  .stat-card .num { font-size: 2rem; font-weight: 700; }
  .stat-card .label { font-size: .85rem; color: #a6adc8; }
  .stat-card.stat-total .num { color: #89b4fa; }
  .stat-card.stat-diff .num { color: #f9e2af; }
  table.diff-table {
    width: 100%; border-collapse: collapse; margin-top: .5rem;
    background: #181825; border-radius: 8px; overflow: hidden;
  }
  .diff-table th {
    background: #313244; padding: 10px 12px; text-align: left;
    font-weight: 600; font-size: .85rem; color: #a6adc8;
    white-space: nowrap; position: sticky; top: 0;
  }
  .diff-table td { padding: 8px 12px; border-top: 1px solid #313244; font-size: .9rem; vertical-align: top; }
  .diff-table tr:hover { background: #1e1e2e; }
  .col-name { min-width: 180px; font-family: 'SFMono-Regular', 'Consolas', monospace; }
  .col-type { width: 100px; color: #a6adc8; }
  .val-present { color: #a6e3a1; }
  .val-missing { color: #f38ba8; font-style: italic; }
  .val-same { color: #585b70; }
  .val-diff { color: #f9e2af; }
  .val-trunc {
    max-width: 200px; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap; display: inline-block; vertical-align: bottom;
  }
  .row-match td { color: #585b70; }
  .row-match .col-name { color: #6c7086; }
  .row-match:hover td { background: rgba(108,112,134,0.05); }
  .row-diff td { color: #cdd6f4; }
  .changed-name {
    cursor: pointer; border-bottom: 1px dashed #f9e2af; color: #f9e2af;
  }
  .row-match .changed-name { color: #6c7086; border-color: #585b70; }
  .row-match .changed-name:hover { text-shadow: 0 0 4px #6c7086; }
  .changed-name:hover { text-shadow: 0 0 8px #f9e2af; }
  .changed-name:hover::after { content: ' ▸'; font-weight: 700; }
  .footer { margin-top: 3rem; text-align: center; color: #6c7086; font-size: .8rem; }

  /* Modal */
  .modal-overlay {
    display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.85); z-index: 1000;
    align-items: flex-start; justify-content: center; padding-top: 30px;
    backdrop-filter: blur(2px);
  }
  .modal-overlay.show { display: flex; }
  .modal-content {
    background: #181825; border: 1px solid #45475a; border-radius: 8px;
    max-width: 92vw; max-height: 82vh; overflow-y: auto; min-width: 440px;
    box-shadow: 0 0 30px rgba(137,180,250,0.12);
  }
  .modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 20px; border-bottom: 1px solid #313244;
    position: sticky; top: 0; background: #181825; border-radius: 8px 8px 0 0; z-index: 1;
  }
  .modal-title { color: #89b4fa; font-size: 1rem; font-weight: 600; }
  .modal-close {
    background: none; border: 1px solid #45475a; color: #a6adc8; font-size: 1rem;
    cursor: pointer; padding: 2px 12px; border-radius: 4px; font-family: inherit;
  }
  .modal-close:hover { color: #f38ba8; border-color: #f38ba8; }
  .modal-body { padding: 20px; }

  /* Comparison tables */
  .cmp-table {
    width: 100%; border-collapse: collapse; font-size: .85rem;
    border: 1px solid #313244;
  }
  .cmp-table th {
    background: #313244; padding: 8px 10px; text-align: left;
    font-weight: 600; color: #a6adc8; white-space: nowrap;
  }
  .cmp-table td { padding: 6px 10px; border-top: 1px solid #313244; }
  .cmp-table tr:hover { background: #1e1e2e; }
  .cmp-label { color: #6c7086; font-weight: 600; }
  .cmp-same  { color: #585b70; }
  .cmp-diff  { color: #f9e2af; }
  .cmp-missing { color: #f38ba8; font-style: italic; }
  .cmp-section-label {
    color: #89b4fa; font-size: .8rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; margin-top: 16px;
  }
  .cmp-summary { font-size: .8rem; margin-top: 8px; }
</style>
</head>
<body>

<h1>Multi-Source Calibration Diff</h1>

<!-- Metadata -->
<div class="meta">
  <table>
    {{#each metadata.sources}}
    <tr>
      <td class="label">{{#if @first}}BASE SOURCE{{else}}SOURCE {{@index}}{{/if}}</td>
      <td class="value"><span class="source-label {{#if @first}}base{{else}}other{{/if}}">{{this}}</span></td>
    </tr>
    {{/each}}
  </table>
</div>

<!-- Statistics -->
<div class="stats">
  <div class="stat-card stat-total">
    <div class="num">{{total_variables}}</div>
    <div class="label">Base Variables</div>
  </div>
  <div class="stat-card stat-diff">
    <div class="num">{{variables_with_diffs}}</div>
    <div class="label">With Differences</div>
  </div>
</div>

<!-- Variables Table -->
{{#if differences}}
<h2>All Base Variables ({{total_variables}})</h2>
<div style="overflow-x: auto;">
<table class="diff-table">
  <thead>
    <tr>
      <th class="col-name">Variable</th>
      <th class="col-type">Type</th>
      <th style="width:80px;">Status</th>
      {{#each metadata.sources}}
      <th>{{#if @first}}Base{{else}}Source {{@index}}{{/if}}</th>
      {{/each}}
    </tr>
  </thead>
  <tbody>
    {{#each differences}}
    <tr class="{{#if has_diff}}row-diff{{else}}row-match{{/if}}">
      <td class="col-name"><span class="changed-name" data-name="{{name}}">{{name}}</span></td>
      <td class="col-type">{{block_type}}</td>
      <td>{{#if has_diff}}<span class="val-diff">✗</span>{{else}}<span class="val-same">✓</span>{{/if}}</td>
      {{#each source_values}}
      <td>
        {{#if present}}
          {{#if value}}
            <span class="val-trunc val-present">{{format_value value}}</span>
          {{else}}
            <span class="val-missing">(no value)</span>
          {{/if}}
        {{else}}
          <span class="val-missing">(missing)</span>
        {{/if}}
      </td>
      {{/each}}
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
{{else}}
<p style="color: #a6e3a1;">All variables match across all sources. No differences found.</p>
{{/if}}

<div class="footer">Generated by DCM Utils</div>

<!-- Modal -->
<div id="diff-modal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-header">
      <span class="modal-title"></span>
      <button class="modal-close" title="Close (Esc)">[x]</button>
    </div>
    <div class="modal-body"></div>
  </div>
</div>

<!-- Embedded full result JSON -->
<script id="diff-data" type="application/json">{{{diff_data_json}}}</script>
<script>
(function() {
  var modal = document.getElementById('diff-modal');
  var modalTitle = modal.querySelector('.modal-title');
  var modalBody = modal.querySelector('.modal-body');
  var dataEl = document.getElementById('diff-data');
  var diffData = null;

  if (dataEl) {
    try { diffData = JSON.parse(dataEl.textContent); } catch(e) { console.error('JSON parse error', e); }
  }

  var sourceLabels = diffData ? diffData.metadata.sources.map(function(s, i) {
    return i === 0 ? 'Base' : 'Source ' + i;
  }) : [];

  // Click handlers on variable names
  var names = document.querySelectorAll('.changed-name');
  for (var i = 0; i < names.length; i++) {
    names[i].addEventListener('click', function() {
      showModal(this.getAttribute('data-name'));
    });
  }

  // Close handlers
  modal.querySelector('.modal-close').addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.classList.contains('show')) closeModal();
  });

  function showModal(name) {
    var diff = diffData && diffData.differences.find(function(d) { return d.name === name; });
    if (!diff) return;
    modalTitle.textContent = name + ' — ' + diff.block_type;
    modalBody.innerHTML = renderMultiSourceDetail(diff);
    modal.classList.add('show');
    modal.scrollTop = 0;
  }

  function closeModal() {
    modal.classList.remove('show');
  }

  function fmt(n) {
    if (typeof n === 'string') return n;
    if (typeof n !== 'number') return String(n);
    return parseFloat(n.toFixed(6)).toString();
  }

  function renderMultiSourceDetail(diff) {
    var numSources = diff.source_values.length;
    var sources = diff.source_values;

    // Determine structure: find max length per source
    var maxLen = 0;
    var arrValues = [];
    for (var s = 0; s < numSources; s++) {
      var sv = sources[s];
      if (sv.present && sv.value) {
        var arr = sv.value; // this is a JSON array of values
        arrValues.push(arr);
        if (arr.length > maxLen) maxLen = arr.length;
      } else {
        arrValues.push([]);
      }
    }

    var html = '';

    // Metadata section
    var isMap = diff.block_type === 'GRUPPENKENNFELD' && diff.dim_x != null;
    if (isMap) {
      html += '<div class="cmp-section-label">Map Details</div>';
      html += '<table class="cmp-table">';
      html += '<tr><td class="cmp-label">Dimensions</td><td>' + diff.dim_x + ' × ' + diff.dim_y + '</td></tr>';
      if (diff.x_axis_name) { html += '<tr><td class="cmp-label">X-Axis</td><td>' + diff.x_axis_name + ' (' + diff.dim_x + ' pts)</td></tr>'; }
      if (diff.y_axis_name) { html += '<tr><td class="cmp-label">Y-Axis</td><td>' + diff.y_axis_name + ' (' + diff.dim_y + ' pts)</td></tr>'; }
      html += '</table>';
    }

    if (maxLen <= 1) {
      // Scalar: show single row per source, compare with base
      var baseVal = sources[0].present && sources[0].value && sources[0].value.length > 0
        ? sources[0].value[0] : undefined;
      html += '<div class="cmp-section-label">Values</div>';
      html += '<table class="cmp-table">';
      html += '<tr><th>Source</th><th>Value</th></tr>';
      for (var s = 0; s < numSources; s++) {
        var sv = sources[s];
        var label = sourceLabels[s] || 'Source ' + s;
        if (sv.present && sv.value && sv.value.length > 0) {
          var v = sv.value[0];
          var isSame = (s === 0) || (baseVal !== undefined && v === baseVal);
          var cls = isSame ? 'cmp-same' : 'cmp-diff';
          html += '<tr><td class="cmp-label">' + label + '</td><td class="' + cls + '">' + fmt(v) + '</td></tr>';
        } else {
          html += '<tr><td class="cmp-label">' + label + '</td><td class="cmp-missing">(missing)</td></tr>';
        }
      }
      html += '</table>';
    } else if (isMap && diff.dim_x && diff.dim_y) {
      // 2D MAP grid: render one grid per source stacked vertically
      for (var s = 0; s < numSources; s++) {
        var sv = sources[s];
        html += '<div class="cmp-section-label">' + sourceLabels[s] + '</div>';
        if (!sv.present) {
          html += '<p class="cmp-missing">(missing)</p>';
          continue;
        }
        if (!sv.value || sv.value.length === 0) {
          html += '<p class="cmp-missing">(no value)</p>';
          continue;
        }

        var vals = sv.value;
        var dx = diff.dim_x;
        var dy = diff.dim_y;
        var xAxis = sv.x_axis || [];
        var yAxis = sv.y_axis || [];

        html += '<table class="cmp-table" style="font-size:.8rem;">';
        // Header row: X-axis values
        html += '<tr><td class="cmp-label" style="min-width:30px;"></td>';
        for (var x = 0; x < dx && x < xAxis.length; x++) {
          html += '<th>' + fmt(xAxis[x]) + '</th>';
        }
        html += '</tr>';

        // Data rows
        for (var y = 0; y < dy; y++) {
          html += '<tr>';
          // Y-axis label
          html += '<td class="cmp-label">' + (yAxis[y] !== undefined ? fmt(yAxis[y]) : '') + '</td>';
          for (var x = 0; x < dx; x++) {
            var idx = y * dx + x;
            if (idx < vals.length) {
              // Compare with base source at same position
              var baseValAtPos = sources[0].present && sources[0].value ? sources[0].value[idx] : undefined;
              var isSame = (s === 0) || (baseValAtPos !== undefined && vals[idx] === baseValAtPos);
              var cls = isSame ? 'cmp-same' : 'cmp-diff';
              html += '<td class="' + cls + '">' + fmt(vals[idx]) + '</td>';
            } else {
              html += '<td class="cmp-missing">&mdash;</td>';
            }
          }
          html += '</tr>';
        }
        html += '</table>';
      }
    } else {
      // Multi-value flat: show table with all sources as columns
      html += '<div class="cmp-section-label">Values</div>';
      html += '<table class="cmp-table">';
      html += '<tr><th>#</th>';
      for (var s = 0; s < numSources; s++) {
        html += '<th>' + sourceLabels[s] + '</th>';
      }
      html += '</tr>';

      for (var i = 0; i < maxLen; i++) {
        var baseValAtIdx = sources[0].present && sources[0].value ? sources[0].value[i] : undefined;
        html += '<tr><td class="cmp-label">' + (i + 1) + '</td>';
        for (var s = 0; s < numSources; s++) {
          var sv = sources[s];
          if (sv.present && sv.value && sv.value[i] !== undefined) {
            var isSame = (s === 0) || (baseValAtIdx !== undefined && sv.value[i] === baseValAtIdx);
            var cls = isSame ? 'cmp-same' : 'cmp-diff';
            html += '<td class="' + cls + '">' + fmt(sv.value[i]) + '</td>';
          } else {
            html += '<td class="cmp-missing">&mdash;</td>';
          }
        }
        html += '</tr>';
      }
      html += '</table>';
    }

    return html;
  }

})();
</script>
</body>
</html>